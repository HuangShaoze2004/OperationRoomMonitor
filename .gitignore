# ---------------------------------------------------------------------------
# PyTorch / model weights
# ---------------------------------------------------------------------------
# Binary model files are ignored by default. To distribute them, either:
#   - Use Git LFS:  git lfs track "weights/*.pt" && git lfs track "*.pth"
#   - Or remove the rules below if files are small (< 10 MB) and safe to commit
*.pt
*.pth
*.onnx
*.engine
*.trt
*.caffemodel

# ---------------------------------------------------------------------------
# OS files
# ---------------------------------------------------------------------------
.directory
.desktop
*:Zone.Identifier
